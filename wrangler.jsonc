{
  // Cloudflare Workers deploy for the pre-built site in dist/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toolbox",
  "compatibility_date": "2025-09-01",
  "main": "worker/index.js",
  "vars": {
    // the one official address; www and the workers.dev URL redirect here
    "CANONICAL_HOST": "thetoolbox.site"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // run the redirect check before serving files
    "run_worker_first": true,
    // /tool/gst serves dist/tool/gst.html
    "html_handling": "auto-trailing-slash",
    // addresses without a file get dist/404.html (status 404); the app still loads and shows the page
    "not_found_handling": "404-page"
  }
}
