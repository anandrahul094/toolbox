{
  // Cloudflare Workers static-assets deploy for the pre-built site in dist/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toolbox",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    // /tool/gst serves dist/tool/gst.html
    "html_handling": "auto-trailing-slash",
    // addresses without a file get dist/404.html (status 404); the app still loads and shows the page
    "not_found_handling": "404-page"
  }
}
