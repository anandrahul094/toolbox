# Your live address, used for canonical links and the sitemap (no trailing slash).
VITE_SITE_URL=https://yourtoolbox.com

# Copy to .env.local and fill in from your Supabase project (Project settings → API).
# Without these, the site still works: feedback and ratings are kept in the browser until connected.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
